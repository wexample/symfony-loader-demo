{%- extends '@WexampleSymfonyLoaderTestingBundle/layouts/test/layout.html.twig' -%}

{%- block layout_config -%}
    {{ parent() }}
    {{- var_export(render_pass, 'initialLayoutVar', true) -}}
    {{- trans_js(render_pass, '@layout::string.client_side') -}}
{%- endblock -%}

{%- block page_config -%}
    {{ parent() }}
    {{- var_export(render_pass, 'initialPageVar', true) -}}
    {{- var_export(render_pass, 'demoVariableBoolean', true) -}}
    {{- var_export(render_pass, 'demoVariableInteger', 123) -}}
    {{- var_export(render_pass, 'demoVariableFloat', 12.3) -}}
    {{- var_export(render_pass, 'demoVariableObject', {testVar:'test'}) -}}
    {{- trans_js(render_pass, '@page::firstGroup.*') -}}
    {{- trans_js(render_pass, '@page::secondGroup.first') -}}
{%- endblock -%}

{%- block page_body -%}
    {#- The run, drawn by the page as it goes: a header saying where it stands,
        then one fold per test class — open when something in it failed. -#}
    <section class="test-report"
             data-label-expected="{{ '@page::report.expected' | trans }}"
             data-label-received="{{ '@page::report.received' | trans }}"
             data-label-error="{{ '@page::report.error' | trans }}">
        <header class="test-report--head">
            <span class="test-report--state"></span>
            <span class="test-report--total-passed">{{ marker('success', '@page::report.passed' | trans, { count: 0, compact: true }) }}</span>
            <span class="test-report--total-failed">{{ marker('error', '@page::report.failed' | trans, { count: 0, compact: true }) }}</span>
            <span class="test-report--duration text-secondary"></span>
        </header>
        <div class="test-report--suites"></div>

        {%- for state, tone in { running: 'running', passed: 'success', failed: 'error' } -%}
            <template data-name="state-{{ state }}">{{ marker(tone, ('@page::report.state.' ~ state) | trans) }}</template>
        {%- endfor -%}
        {%- for name, glyph in { pass: 'ph:bold/check-circle', fail: 'ph:bold/x-circle', error: 'ph:bold/warning-circle', running: 'ph:bold/circle-notch' } -%}
            <template data-name="icon-{{ name }}"><span class="test-report--icon test-report--icon--{{ name }}" aria-hidden="true">{{ icon(glyph) }}</span></template>
        {%- endfor -%}
    </section>

    {#- What the tests read and write, kept as they are: a test reads their
        text and their colours, so only the panel around them is the page's. It
        stays laid out, a test measuring the playground inside it. -#}
    <section class="test-fixtures">
        <div class="test-fixtures--bar">
            {{ icon('ph:bold/flask') }}
            <span class="test-fixtures--title">{{ '@page::report.fixtures' | trans }}</span>
            <span class="test-fixtures--hint">{{ '@page::report.fixtures_hint' | trans }}</span>
        </div>
        <div class="test-fixtures--body">
            <div class="test-string">TESTS PAGE</div>
            <div id="test-layout-translation">{{ '@layout::secondGroup.first' | trans }}</div>
            <div id="test-layout-component">{{ component(render_pass, '@WexampleSymfonyLoaderTestingBundle/components/test-component', {testOption:true}) }}</div>
            <div id="test-playground"></div>
        </div>
    </section>
{% endblock %}