{%- extends '@WexampleSymfonyLoaderTestingBundle/layouts/demo/layout.html.twig' -%}

{%- block page_config -%}
    {{- trans_js(render_pass, '@page::javascript.*') -}}
{%- endblock -%}

{%- block page_body -%}
    <h2>{{ '@page::domains.title' | trans }}</h2>
    <div class="block block--padded">
        <p>{{ '@page::domains.body' | trans }}</p>
        {% set code %}// {{ '@page::domains.context.layout' | trans }}
{{ "{{ '@layout::meta.description' | trans }}" }}
// {{ '@page::domains.context.page' | trans }}
{{ "{{ '@page::page_title' | trans }}" }}{% endset %}
        {{ include('@WexampleSymfonyDesignSystemBundle/components/code-block/code-block.html.twig', {lang: 'twig', code: code}) }}
    </div>

    <h2>{{ '@page::includes.title' | trans }}</h2>
    <div class="block block--padded">
        <p>{{ '@page::includes.body' | trans | raw }}</p>
        {% set code %}# translation-file-one.en.yml
example_key:
  example_sub_key: Translation string

# translation-file-two.en.yml
example_key:
  # Using this key resolves to the first file
  # using the same key "example_key.example_sub_key"
  example_sub_key: '@translation-file-one::%'{% endset %}
        {{ include('@WexampleSymfonyDesignSystemBundle/components/code-block/code-block.html.twig', {lang: 'yaml', code: code}) }}
    </div>

    <h2>{{ '@page::extends.title' | trans }}</h2>
    <div class="block block--padded">
        <p>{{ '@page::extends.body' | trans | raw }}</p>
        {% set code %}# translation-file-two.en.yml
~extends: '@translation-file-one'{% endset %}
        {{ include('@WexampleSymfonyDesignSystemBundle/components/code-block/code-block.html.twig', {lang: 'yaml', code: code}) }}
    </div>

    <h2>{{ '@page::cache.title' | trans }}</h2>
    <div class="block block--padded">
        <p>{{ '@page::cache.body' | trans }}</p>
    </div>

    <h2>{{ '@page::javascript.title' | trans }}</h2>
    <div class="block block--padded">
        <p>{{ '@page::javascript.body' | trans }}</p>
        {% set code %}// template.html.twig
trans_js('@page::javascript.*'){% endset %}
        {{ include('@WexampleSymfonyDesignSystemBundle/components/code-block/code-block.html.twig', {lang: 'twig', code: code}) }}
        {% set code %}// Hello Javascript!
app.layout.page.trans('@page::javascript.demo_text');{% endset %}
        {{ include('@WexampleSymfonyDesignSystemBundle/components/code-block/code-block.html.twig', {lang: 'javascript', code: code}) }}
        <p>
            <button onclick="alert(app.layout.page.trans('@page::javascript.demo_text'));">{{ '@page::javascript.test_button' | trans }}</button>
        </p>
    </div>
{%- endblock -%}
